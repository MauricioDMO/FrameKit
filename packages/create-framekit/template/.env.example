# Optional; defaults to false. Enable authentication before exposing FrameKit in production.
FRAMEKIT_AUTH_ENABLED=false
# Used only when FRAMEKIT_AUTH_ENABLED=true; defaults to admin. During first-user bootstrap, use 3-64 ASCII letters, numbers, ., _, or -.
FRAMEKIT_ADMIN_USERNAME=admin
# Used only when FRAMEKIT_AUTH_ENABLED=true and while bootstrapping the first user in an empty database; must be 12-256 UTF-8 bytes.
FRAMEKIT_ADMIN_PASSWORD=replace-me-with-a-strong-password
# Optional persistent SQLite path; defaults to .framekit-data/framekit.sqlite. (:memory: is not persistent.)
FRAMEKIT_DATABASE_PATH=.framekit-data/framekit.sqlite
# Standard process port for the server and private loopback origin; defaults to 3000.
PORT=3000
# Optional comma-separated exact hostnames; defaults to empty (remote images disabled). Hostnames are limited to 253 characters; IP literals are rejected.
FRAMEKIT_ALLOWED_IMAGE_HOSTS=
# Optional integer; defaults to 2; range 1-32.
FRAMEKIT_MAX_CONCURRENT_RENDERS=2
# Optional integer in milliseconds; defaults to 30000; range 1-120000.
FRAMEKIT_RENDER_TIMEOUT_MS=30000
