{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "umami": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "--package",
        "umami-analytics-mcp",
        "umami-mcp",
        "--env-file",
        ".env"
      ],
      "cwd": ".",
      "enabled": true
    }
  }
}
