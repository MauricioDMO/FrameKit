---
import { IconArrowUpRight, IconFolder, IconRocket } from '@tabler/icons-astro'
import type { LandingContent } from '../../content/landing'

interface Props {
  copy: LandingContent
}

const { copy } = Astro.props
const paths = [
  copy.paths.newProject,
  copy.paths.existingProject,
]
---

<section class="mx-auto w-[calc(100%-2rem)] max-w-6xl pb-24 sm:w-[calc(100%-3rem)] sm:pb-28" aria-labelledby="paths-title">
  <div class="mb-8 max-w-xl">
    <p class="mb-5 text-xs font-extrabold uppercase tracking-[0.16em] text-[#b9f8d2]">Start here</p>
    <h2 id="paths-title" class="mb-3 text-4xl font-extrabold leading-none tracking-[-0.055em] sm:text-5xl">{copy.pathsTitle}</h2>
    <p class="mb-0 leading-[1.6] text-[#91ae9f]">{copy.pathsDescription}</p>
  </div>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {paths.map((path, index) => (
      <a
        class="group border border-white/15 bg-[#10271f]/70 p-6 no-underline transition-colors hover:border-[#b9f8d2]/55 hover:bg-[#2a3931]/80 focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4"
        href={path.href}
      >
        <span class="mb-10 flex items-center justify-between text-[#b9f8d2]">
          {index === 0 ? <IconRocket size={22} stroke={1.8} aria-hidden="true" /> : <IconFolder size={22} stroke={1.8} aria-hidden="true" />}
          <IconArrowUpRight class="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 motion-reduce:transition-none" size={20} stroke={1.8} aria-hidden="true" />
        </span>
        <strong class="mb-3 block text-xl tracking-[-0.03em]">{path.title}</strong>
        <span class="block text-[0.92rem] leading-[1.55] text-[#91ae9f]">{path.description}</span>
      </a>
    ))}
  </div>
</section>
