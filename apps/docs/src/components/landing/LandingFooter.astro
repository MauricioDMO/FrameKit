---
import { IconArrowRight } from '@tabler/icons-astro'
import type { LandingContent, LandingLanguage } from '../../content/landing'

interface Props {
  copy: LandingContent
  language: LandingLanguage
}

const { copy, language } = Astro.props
---

<footer class="mx-auto flex w-[calc(100%-2rem)] max-w-6xl justify-between gap-4 border-t border-white/10 py-6 text-sm text-[#91ae9f] sm:w-[calc(100%-3rem)]">
  <span>FrameKit</span>
  <a class="flex items-center gap-2 text-[#b9f8d2] no-underline hover:text-[#f5f7ee] focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4" href={`/${language}/users/`}>
    {copy.footerDocs}
    <IconArrowRight size={16} stroke={1.8} aria-hidden="true" />
  </a>
</footer>
