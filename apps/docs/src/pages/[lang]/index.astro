---
import "../../styles/global.css";

const content = {
  en: {
    lang: "en",
    title: "FrameKit Documentation",
    description:
      "Build template-based image editing experiences with FrameKit.",
    brandHome: "FrameKit home",
    navigation: "Main navigation",
    skipToContent: "Skip to content",
    docs: "Documentation",
    language: "Language",
    languageNames: { en: "English", es: "Español" },
    eyebrow: "Template-based image editor",
    heroTitle: "Build visual image experiences with FrameKit.",
    heroDescription:
      "Create reusable templates, edit them in Studio, and ship generated React or Next.js projects with a workflow that stays close to your codebase.",
    getStarted: "Get started",
    contribute: "Contribute to FrameKit",
    pathsTitle: "Choose your path",
    pathsDescription: "Start with the guide that matches what you want to do.",
    usersTitle: "Use FrameKit",
    usersDescription:
      "Learn how to create image editing experiences with Studio, the CLI, and generated projects.",
    contributorsTitle: "Contribute to FrameKit",
    contributorsDescription:
      "Explore the repository architecture and the workflow for improving FrameKit.",
  },
  es: {
    lang: "es",
    title: "Documentación de FrameKit",
    description:
      "Crea experiencias de edición de imágenes basadas en plantillas con FrameKit.",
    brandHome: "Inicio de FrameKit",
    navigation: "Navegación principal",
    skipToContent: "Saltar al contenido",
    docs: "Documentación",
    language: "Idioma",
    languageNames: { en: "English", es: "Español" },
    eyebrow: "Editor de imágenes basado en plantillas",
    heroTitle: "Crea experiencias visuales de edición con FrameKit.",
    heroDescription:
      "Crea plantillas reutilizables, edítalas en Studio y publica proyectos React o Next.js generados con un flujo que permanece cerca de tu código.",
    getStarted: "Primeros pasos",
    contribute: "Contribuir a FrameKit",
    pathsTitle: "Elige tu recorrido",
    pathsDescription:
      "Empieza con la guía que corresponda a lo que quieres hacer.",
    usersTitle: "Usar FrameKit",
    usersDescription:
      "Aprende a crear experiencias de edición de imágenes con Studio, la CLI y proyectos generados.",
    contributorsTitle: "Contribuir a FrameKit",
    contributorsDescription:
      "Explora la arquitectura del repositorio y el flujo de trabajo para mejorar FrameKit.",
  },
} as const;

type Language = keyof typeof content;

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const language = Astro.params.lang as Language;
const copy = content[language];
const languages = ["en", "es"] as const;
---

<!doctype html>
<html lang={copy.lang} class="scheme-dark bg-[#071a15]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{copy.title}</title>
  </head>
  <body class="m-0 bg-[#071a15] font-sans text-[#f5f7ee]">
    <a
      class="absolute left-4 top-4 z-20 translate-y-[-200%] rounded-lg bg-[#c8f7d9] px-3.5 py-2.5 text-[#071a15] transition-transform focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4"
      href="#main-content">{copy.skipToContent}</a
    >
    <div
      class="min-h-screen overflow-hidden bg-[radial-gradient(circle_at_8%_8%,rgba(185,248,210,0.1),transparent_26rem),radial-gradient(circle_at_91%_42%,rgba(42,57,49,0.62),transparent_32rem)]"
    >
      <header class="border-b border-white/10 bg-[#10271f]/70 backdrop-blur-lg">
        <div
          class="mx-auto flex min-h-18 w-[calc(100%-2rem)] max-w-6xl items-center justify-between gap-6 sm:w-[calc(100%-3rem)] max-sm:flex-col max-sm:items-start max-sm:py-4"
        >
          <a
            class="flex items-center gap-2.5 text-[1.05rem] font-extrabold tracking-[-0.04em] no-underline focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4"
            href={`/${language}/`}
            aria-label={copy.brandHome}
          >
            <img
              class="h-8 w-8"
              src="/favicon.svg"
              alt=""
              width="32"
              height="32"
            />
            <span>FrameKit</span>
          </a>

          <nav
            class="flex items-center gap-5 text-sm max-sm:w-full max-sm:justify-between"
            aria-label={copy.navigation}
          >
            <a
              class="text-[#b9f8d2] no-underline transition-colors hover:text-[#f5f7ee] focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4"
              href={`/${language}/users/`}>{copy.docs}</a
            >
            <div
              class="flex items-center gap-1 border-l border-white/20 pl-5"
              aria-label={copy.language}
            >
              {
                languages.map((locale) => (
                  <a
                    class:list={[
                      "rounded-full px-2 py-1 no-underline transition-colors focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4",
                      locale === language
                        ? "bg-[#c8f7d9] text-[#071a15]"
                        : "text-[#b9f8d2] hover:text-[#f5f7ee]",
                    ]}
                    href={`/${locale}/`}
                    aria-current={locale === language ? "page" : undefined}
                  >
                    {copy.languageNames[locale]}
                  </a>
                ))
              }
            </div>
          </nav>
        </div>
      </header>

      <main id="main-content">
        <section
          class="mx-auto grid w-[calc(100%-2rem)] max-w-6xl grid-cols-1 items-center gap-12 py-20 sm:w-[calc(100%-3rem)] sm:py-24 lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)] lg:gap-20 lg:py-36"
          aria-labelledby="hero-title"
        >
          <div class="max-w-2xl">
            <p
              class="mb-5 text-xs font-extrabold uppercase tracking-[0.16em] text-[#b9f8d2]"
            >
              {copy.eyebrow}
            </p>
            <h1
              id="hero-title"
              class="mb-6 max-w-[12ch] text-5xl font-extrabold leading-[0.98] tracking-[-0.055em] sm:text-6xl lg:text-[5.8rem]"
            >
              {copy.heroTitle}
            </h1>
            <p
              class="mb-8 max-w-xl text-[1.05rem] leading-[1.65] text-[#91ae9f] sm:text-xl"
            >
              {copy.heroDescription}
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                class="rounded-full bg-[#c8f7d9] px-5 py-3 text-sm font-bold text-[#071a15] no-underline transition-transform hover:-translate-y-0.5 hover:bg-[#f5f7ee] focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4 motion-reduce:transition-none"
                href={`/${language}/users/getting-started/`}
                >{copy.getStarted}</a
              >
              <a
                class="rounded-full border border-[#b9f8d2]/35 px-5 py-3 text-sm font-bold text-[#c8f7d9] no-underline transition-transform hover:-translate-y-0.5 hover:border-[#c8f7d9] hover:bg-[#b9f8d2]/10 focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4 motion-reduce:transition-none"
                href={`/${language}/contributors/`}>{copy.contribute}</a
              >
            </div>
          </div>

          <div
            class="relative grid min-h-72 place-items-center sm:min-h-80"
            aria-hidden="true"
          >
            <div
              class="absolute h-76 w-76 rotate-18 rounded-[42%_58%_58%_42%] border border-[#b9f8d2]/25 bg-[#2a3931]/50"
            >
            </div>
            <div
              class="relative w-full max-w-md rotate-[-5deg] overflow-hidden rounded-2xl border border-[#c8f7d9]/35 bg-[#10271f] shadow-2xl shadow-black/30"
            >
              <div class="flex gap-1.5 border-b border-white/10 px-4 py-3">
                <span class="h-2 w-2 rounded-full bg-[#b9f8d2]"></span>
                <span class="h-2 w-2 rounded-full bg-[#537568]"></span>
                <span class="h-2 w-2 rounded-full bg-[#537568]"></span>
              </div>
              <div
                class="grid min-h-72 grid-cols-[minmax(0,1fr)_4rem] gap-4 p-4"
              >
                <div class="relative overflow-hidden rounded-xl bg-[#f5f7ee]">
                  <div
                    class="absolute right-[-12%] top-[12%] aspect-square w-[70%] rounded-full bg-[#b9f8d2]"
                  >
                  </div>
                  <div
                    class="absolute bottom-[-12%] left-[-10%] aspect-square w-[72%] rounded-full bg-[#537568]"
                  >
                  </div>
                  <div
                    class="absolute left-[16%] top-[43%] h-3 w-[72%] -rotate-12 rounded-full bg-[#10271f]"
                  >
                  </div>
                </div>
                <div class="flex flex-col gap-3 pt-2">
                  <span class="h-3 w-4/5 rounded-full bg-[#b9f8d2]"></span>
                  <span class="h-3 w-full rounded-full bg-[#537568]"></span>
                  <span class="h-3 w-3/5 rounded-full bg-[#537568]"></span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section
          class="mx-auto w-[calc(100%-2rem)] max-w-6xl pb-28 sm:w-[calc(100%-3rem)]"
          aria-labelledby="paths-title"
        >
          <div class="mb-8 max-w-xl">
            <p
              class="mb-5 text-xs font-extrabold uppercase tracking-[0.16em] text-[#b9f8d2]"
            >
              FrameKit Docs
            </p>
            <h2
              id="paths-title"
              class="mb-3 text-4xl font-extrabold leading-none tracking-[-0.055em] sm:text-5xl"
            >
              {copy.pathsTitle}
            </h2>
            <p class="mb-0 leading-[1.6] text-[#91ae9f]">
              {copy.pathsDescription}
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <a
              class="grid min-h-48 grid-cols-[auto_1fr_auto] items-start gap-4 rounded-2xl border border-white/15 bg-[#10271f]/70 p-5 no-underline transition-transform hover:-translate-y-0.5 hover:border-[#b9f8d2]/55 hover:bg-[#2a3931]/80 focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4 motion-reduce:transition-none"
              href={`/${language}/users/`}
            >
              <span
                class="text-xs font-extrabold tracking-[0.08em] text-[#537568]"
                >01</span
              >
              <span class="flex flex-col gap-3">
                <strong class="text-xl tracking-[-0.03em]"
                  >{copy.usersTitle}</strong
                >
                <span class="text-[0.92rem] leading-[1.55] text-[#91ae9f]"
                  >{copy.usersDescription}</span
                >
              </span>
            </a>
            <a
              class="grid min-h-48 grid-cols-[auto_1fr_auto] items-start gap-4 rounded-2xl border border-white/15 bg-[#10271f]/70 p-5 no-underline transition-transform hover:-translate-y-0.5 hover:border-[#b9f8d2]/55 hover:bg-[#2a3931]/80 focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4 motion-reduce:transition-none"
              href={`/${language}/contributors/`}
            >
              <span
                class="text-xs font-extrabold tracking-[0.08em] text-[#537568]"
                >02</span
              >
              <span class="flex flex-col gap-3">
                <strong class="text-xl tracking-[-0.03em]">
                  {copy.contributorsTitle}
                </strong>
                <span class="text-[0.92rem] leading-[1.55] text-[#91ae9f]">
                  {copy.contributorsDescription}
                </span>
              </span>
            </a>
          </div>
        </section>
      </main>

      <footer
        class="mx-auto flex w-[calc(100%-2rem)] max-w-6xl justify-between gap-4 border-t border-white/10 py-6 text-sm text-[#91ae9f] sm:w-[calc(100%-3rem)]"
      >
        <span>FrameKit</span>
        <a
          class="text-[#b9f8d2] no-underline hover:text-[#f5f7ee] focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4"
          href={`/${language}/users/`}>{copy.docs}</a
        >
      </footer>
    </div>
  </body>
</html>
