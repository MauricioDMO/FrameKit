---
import "../../styles/global.css";
import type { LandingLanguage } from "../../content/landing";
import { landingContent as en } from "../../content/landing/en";
import { landingContent as es } from "../../content/landing/es";
import Analytics from "../../components/analytics/Analytics.astro";
import LandingFooter from "../../components/landing/LandingFooter.astro";
import LandingHeader from "../../components/landing/LandingHeader.astro";
import LandingHero from "../../components/landing/LandingHero.astro";
import StartingPaths from "../../components/landing/StartingPaths.astro";
import WorkflowSection from "../../components/landing/WorkflowSection.astro";

const content = { en, es };
type Language = keyof typeof content;

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const language = Astro.params.lang as LandingLanguage;
const copy = content[language as Language];
const languages = ["en", "es"] as const;
const siteUrl = Astro.site ?? new URL("https://framekit.mauriciodmo.com");
const canonicalUrl = new URL(`/${language}/`, siteUrl).href;
const ogImageUrl = new URL(
  `/assets/og-framekit-home${language === "es" ? "-es" : ""}.jpg`,
  siteUrl,
).href;
const locale = language === "en" ? "en_US" : "es_ES";
const alternateLocale = language === "en" ? "es_ES" : "en_US";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonicalUrl,
  name: copy.title,
  description: copy.description,
  url: canonicalUrl,
  image: ogImageUrl,
  inLanguage: copy.lang,
  isPartOf: {
    "@type": "WebSite",
    name: "FrameKit",
    url: siteUrl.href,
  },
};
---

<!doctype html>
<html lang={copy.lang} class="scheme-dark bg-[#071a15]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#071a15" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", siteUrl)} />
    <link rel="alternate" hreflang="es" href={new URL("/es/", siteUrl)} />
    <link rel="alternate" hreflang="x-default" href={new URL("/en/", siteUrl)} />

    <link rel="icon" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <Analytics />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FrameKit" />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Mauricio_DMO" />
    <meta name="twitter:title" content={copy.title} />
    <meta name="twitter:description" content={copy.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={copy.title} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{copy.title}</title>
  </head>
  <body class="m-0 bg-[#071a15] font-sans text-[#f5f7ee]">
    <a
      class="absolute left-4 top-4 z-20 translate-y-[-200%] rounded-lg bg-[#c8f7d9] px-3.5 py-2.5 text-[#071a15] transition-transform focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-[#b9f8d2] focus-visible:outline-offset-4"
      href="#main-content">{copy.skipToContent}</a
    >
    <div
      class="min-h-screen overflow-hidden bg-[radial-gradient(circle_at_8%_8%,rgba(185,248,210,0.08),transparent_26rem),radial-gradient(circle_at_91%_42%,rgba(42,57,49,0.5),transparent_32rem)]"
    >
      <LandingHeader copy={copy} language={language} languages={languages} />

      <main id="main-content">
        <LandingHero copy={copy} language={language} />
        <WorkflowSection copy={copy} />
        <StartingPaths copy={copy} />
      </main>

      <LandingFooter copy={copy} language={language} />
    </div>
  </body>
</html>
